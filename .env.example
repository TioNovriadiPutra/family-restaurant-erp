# Copy this file to .env.local and fill in your Supabase project's public settings.
# Get the Project URL and publishable key from the Supabase project dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: Supabase secret API key for future Auth administration.
# Never prefix with NEXT_PUBLIC_ or expose this value to the browser.
# Not used by the current employee profile-only flow.
SUPABASE_SECRET_KEY=
